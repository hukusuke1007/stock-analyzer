{
  "name": "stock-analyzer",
  "version": "0.2.0",
  "description": "株分析シミュレーター: 日本株の買い判断とランク付けを行う株分析ツール(TanStack Start の Web アプリ)。判定とランク付けに Codex App Server / Jev を使う",
  "license": "MIT",
  "keywords": [
    "stock",
    "japan",
    "technical-analysis",
    "swing-trade",
    "codex",
    "jev"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:import": "tsx --env-file-if-exists=.env scripts/import-json.ts",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-store": "^0.11.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "lightweight-charts": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "nitro": "3.0.260903-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
