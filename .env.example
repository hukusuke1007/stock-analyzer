# 判定の AI(Codex / Jev)と Codex のモデルは、画面の設定(左ツールバーの歯車)で切り替える。
# ここには、画面で扱わない秘密情報と起動時の設定だけを書く。

# 判定の AI を Jev にするときだけ使う。https://console.typesafe.ai/keys で発行したキー
TYPESAFE_API_KEY=

# 必要なときだけ上書きする(README の「環境変数」)
# CODEX_BIN=codex
# DECISIONS_EFFORT=low
# RANK_EFFORT=medium
# DATA_DIR=./data
# PORT=3000
